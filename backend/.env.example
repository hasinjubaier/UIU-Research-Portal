# Application
APP_NAME=UIU_Research_Portal
APP_ENV=development
APP_URL=http://localhost:8000
APP_DEBUG=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uiu_research_portal
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=86400
JWT_REFRESH_EXPIRE=604800

# File Uploads
UPLOAD_DIR=../storage/uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,csv,zip,png,jpg,jpeg

# Mail (Optional / PHPMailer)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@uiu.ac.bd
MAIL_FROM_NAME="UIU Research Portal"

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
